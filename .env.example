# Copie para .env e preencha os valores
META_ACCESS_TOKEN=YOUR_META_ACCESS_TOKEN
APP_SECRET=YOUR_APP_SECRET
VERIFY_TOKEN=your_verify_token
PORT=3000
GRAPH_V=v17.0
# Opcional: ID do número de telefone (usado para enviar mensagens)
PHONE_NUMBER_ID=
# Se quiser habilitar transcrição automática (integração externa), configure aqui
TRANSCRIBE=false
# Exemplo: OPENAI_API_KEY=sk-xxxx
OPENAI_API_KEY=

